        <item name="colorOnSecondaryContainer">@color/np_on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/np_tertiary</item>
        <item name="colorOnTertiary">@color/np_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/np_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/np_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/np_error</item>

        <item name="colorSurfaceContainerHigh">@color/np_surface_container_high</item>
        <item name="colorOutline">@color/np_outline</item>
        <item name="colorOutlineVariant">@color/np_outline_variant</item>

        <!-- Inverse -->
        <item name="colorSurfaceInverse">@color/np_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/np_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/np_inverse_primary</item>
